# Copy to terraform.tfvars (or pass via CI) and fill in real values.
# Do NOT commit real secrets.

aws_region  = "us-east-1"
environment = "develop"

# O issuer resolve o cliente por REST no Customer Service (não lê mais o banco).
# Use o DNS do NLB interno do customer-service (o *.svc.cluster.local não resolve fora do cluster).
customer_service_url          = "http://<dns-do-nlb-interno-do-customer>:8080"
customer_service_url_internal = true
vpc_subnet_ids         = ["subnet-aaaa", "subnet-bbbb"]
vpc_security_group_ids = ["sg-aaaa"]

# JWT (RS256): a chave pública tem de ser a mesma JWT_PUBLIC_KEY dos microsserviços.
# Par RSA (Base64 do DER, numa linha). Gerar: ver o guia de deploy (FASE 2).
jwt_private_key   = "<chave privada PKCS#8 em Base64>"
jwt_public_key    = "<chave pública X.509 em Base64>"
jwt_expiration_ms = 86400000
